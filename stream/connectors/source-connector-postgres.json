{
    "name": "source-connector-postgres",
    "config": {
      "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
      "tasks.max": "1",
      "database.hostname": "postgres",
      "database.port": "5432",
      "database.user": "postgres",
      "database.password": "postgres",
      "database.dbname": "postgres",
      "database.server.name": "postgres",
      "plugin.name": "pgoutput",
      "slot.name": "postgres_slot",
      "publication.name": "postgres_pub",
      "schema.history.internal.kafka.bootstrap.servers": "broker:29092",
      "schema.history.internal.kafka.topic": "schema-changes.CRBT",
      "topic.prefix": "cdc_postgres",
      "snapshot.mode": "initial",
      "table.include.list": "public.orders,CRBT.sub_collection_log,CRBT.charge_log,CRBT.substate_log"
    }
  }
